{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext", "DOM"],

    "paths": {
      "@/*": ["./src/*"]
    },

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    
    "strict": true,
    "skipLibCheck": true,
  }
}
